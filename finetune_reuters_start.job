#!/bin/bash
#SBATCH -J finetune_reuters_start
#SBATCH --partition zen3_0512_a100x2
#SBATCH --qos zen3_0512_a100x2_devel
#SBATCH --gres=gpu:1
#SBATCH --time=00:10:00
#SBATCH --output=finetune_reuters_start.log

module purge
module load python/3.11.3-gcc-12.2.0-hn7p65z
source $DATA/venvs/bsc/bin/activate
cd $DATA/bsc

nvidia-smi
# starts the real Reuters fine-tuning (top 2 layers, lr 2e-5) on devel, up to epoch 7.
# Continue with finetune_reuters_continue.job until the run is finished.
python -u -m finetuning.finetune --dataset reuters --max-epochs 7
