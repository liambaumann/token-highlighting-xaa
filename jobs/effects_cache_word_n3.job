#!/bin/bash
#SBATCH -J effects_cache_word_n3
#SBATCH --partition zen3_0512_a100x2
#SBATCH --qos zen3_0512_a100x2_devel
#SBATCH --gres=gpu:1
#SBATCH --time=00:10:00
#SBATCH --output=effects_cache_word_n3.log

module purge
module load python/3.11.3-gcc-12.2.0-hn7p65z
source $DATA/venvs/bsc/bin/activate
cd $DATA/bsc

nvidia-smi
# raw LUAR embeddings of the sampled val comments (each with its word trigrams removed) and of all test
# comments, with the dataset, model and perturbation set in config.py (MODE must be plain).
# Stops after ~8 minutes; submit again to continue the same series.
python -u -m effects.cache --unit word --n 3
