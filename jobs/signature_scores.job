#!/bin/bash
#SBATCH -J signature_scores
#SBATCH --partition zen3_0512_a100x2
#SBATCH --qos zen3_0512_a100x2_devel
#SBATCH --gres=gpu:1
#SBATCH --time=00:10:00
#SBATCH --output=signature_scores.log

module purge
module load python/3.11.3-gcc-12.2.0-hn7p65z
source $DATA/venvs/bsc/bin/activate
cd $DATA/bsc

nvidia-smi
# occlusion scores (n = 1) of the sampled comments of signature/scores.py's SPLIT, with the
# dataset, mode, model and perturbation set in config.py. Stops after ~8 minutes; submit again
# to continue the same series. Signatures are built locally afterwards: python -m signature.tokens
python -u -m signature.scores
