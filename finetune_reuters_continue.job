#!/bin/bash
#SBATCH -J finetune_reuters_continue
#SBATCH --partition zen3_0512_a100x2
#SBATCH --qos zen3_0512_a100x2_devel
#SBATCH --gres=gpu:1
#SBATCH --time=00:10:00
#SBATCH --output=finetune_reuters_continue.log

module purge
module load python/3.11.3-gcc-12.2.0-hn7p65z
source $DATA/venvs/bsc/bin/activate
cd $DATA/bsc

nvidia-smi
# continues the Reuters fine-tuning from the last saved epoch. Submit again until the log says
# "reached max_epochs 20" or "early stopping".
python -u -m finetuning.finetune --dataset reuters --resume --max-epochs 20
