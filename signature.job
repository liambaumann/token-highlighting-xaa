#!/bin/bash
#SBATCH -J signature
#SBATCH --partition zen3_0512_a100x2
#SBATCH --qos zen3_0512_a100x2_devel
#SBATCH --gres=gpu:1
#SBATCH --time=00:10:00
#SBATCH --output=signature.log

module purge
module load python/3.11.3-gcc-12.2.0-hn7p65z
source $DATA/venvs/bsc/bin/activate
cd $DATA/bsc

nvidia-smi
# keep-top-k experiment with the dataset, mode, model and perturbation set in config.py.
# Stops after ~8 minutes; submit again to continue the same series (Reuters needs several runs).
python -u -m signature.run
