#!/bin/bash
#SBATCH -J finetune_smoke_test
#SBATCH --partition zen3_0512_a100x2
#SBATCH --qos zen3_0512_a100x2_devel
#SBATCH --gres=gpu:1
#SBATCH --time=00:10:00
#SBATCH --output=finetune_smoke_test.log

module purge
module load python/3.11.3-gcc-12.2.0-hn7p65z
source $DATA/venvs/bsc/bin/activate
cd $DATA/bsc

nvidia-smi
# a fresh smoke run (2 epochs), then resume it for one more epoch to test --resume
python -u -m finetuning.finetune --dataset reuters --smoke-test && \
python -u -m finetuning.finetune --dataset reuters --smoke-test --resume --max-epochs 3
